OPENCLAW_IMAGE=ghcr.io/flyinghail/openclaw-stack:latest
OPENCLAW_ENV_FILE=./.env

OPENCLAW_DATA_DIR=.

# 生成一个强随机值，例如：
# openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=replace-with-random-hex-token
OPENCLAW_GATEWAY_BIND=lan
OPENCLAW_GATEWAY_PUBLIC_PORT=18789
OPENCLAW_BRIDGE_PUBLIC_PORT=18790

OPENCLAW_CONTROL_UI_ORIGINS=https://openclaw.example.com:18789

OPENCLAW_TZ=UTC
OPENCLAW_CLI_COLUMNS=160
OPENCLAW_CLI_LINES=40

OPENCLAW_DISABLE_BONJOUR=1
OPENCLAW_ALLOW_INSECURE_PRIVATE_WS=